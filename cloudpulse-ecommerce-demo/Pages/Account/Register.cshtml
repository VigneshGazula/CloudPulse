@page "/Account/Register"
@model cloudpulse_ecommerce_demo.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Create Account - CLOUDPULSE";
}

<div class="min-h-[80vh] flex flex-col justify-center items-center py-12 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-primary/5 via-background to-background">
    <div class="w-full max-w-md space-y-8">
        
        <!-- Header & Logo -->
        <div class="text-center">
            <a asp-page="/Index" class="inline-flex items-center gap-2.5 group mb-4">
                <div class="w-10 h-10 rounded-custom-sm bg-primary/10 text-primary flex items-center justify-center group-hover:scale-105 transition-transform shadow-2xs">
                    <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 14l5-5 4 4 7-7" />
                        <path d="M2 18h20" />
                    </svg>
                </div>
                <span class="text-2xl font-extrabold tracking-tight text-foreground">
                    CLOUD<span class="text-primary font-black">PULSE</span>
                </span>
            </a>
            <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-foreground">
                Create an Account
            </h1>
            <p class="mt-2 text-sm text-muted-foreground">
                Join the Pulse Club for member-only sneaker drops, personalized fit recommendations, and express order tracking.
            </p>
        </div>

        <!-- Register Card -->
        <div class="rounded-custom bg-card border border-border p-6 sm:p-8 shadow-sm">
            <form method="post" asp-route-returnUrl="@Model.ReturnUrl" class="space-y-4">
                <div asp-validation-summary="ModelOnly" class="p-3 rounded-custom-sm bg-red-500/10 border border-red-500/20 text-red-600 dark:text-red-400 text-xs font-semibold"></div>

                <!-- Username -->
                <div>
                    <label asp-for="Input.Username" class="block text-xs font-bold uppercase tracking-wider text-foreground mb-1.5">
                        Username
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-muted-foreground">
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        </div>
                        <input asp-for="Input.Username" 
                               required 
                               placeholder="Choose a username" 
                               autocomplete="username"
                               class="w-full pl-10 pr-4 py-2.5 text-sm bg-background border border-border rounded-custom-sm focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary text-foreground placeholder:text-muted-foreground transition-all" />
                    </div>
                    <span asp-validation-for="Input.Username" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                <!-- Email -->
                <div>
                    <label asp-for="Input.Email" class="block text-xs font-bold uppercase tracking-wider text-foreground mb-1.5">
                        Email Address
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-muted-foreground">
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                        </div>
                        <input asp-for="Input.Email" 
                               type="email"
                               required 
                               placeholder="you@example.com" 
                               autocomplete="email"
                               class="w-full pl-10 pr-4 py-2.5 text-sm bg-background border border-border rounded-custom-sm focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary text-foreground placeholder:text-muted-foreground transition-all" />
                    </div>
                    <span asp-validation-for="Input.Email" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                <!-- Password -->
                <div>
                    <label asp-for="Input.Password" class="block text-xs font-bold uppercase tracking-wider text-foreground mb-1.5">
                        Password
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-muted-foreground">
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        </div>
                        <input asp-for="Input.Password" 
                               type="password"
                               required 
                               placeholder="At least 6 characters" 
                               autocomplete="new-password"
                               class="w-full pl-10 pr-4 py-2.5 text-sm bg-background border border-border rounded-custom-sm focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary text-foreground placeholder:text-muted-foreground transition-all" />
                    </div>
                    <span asp-validation-for="Input.Password" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                <!-- Confirm Password -->
                <div>
                    <label asp-for="Input.ConfirmPassword" class="block text-xs font-bold uppercase tracking-wider text-foreground mb-1.5">
                        Confirm Password
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-muted-foreground">
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 12 2 2 4-4"/><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        </div>
                        <input asp-for="Input.ConfirmPassword" 
                               type="password"
                               required 
                               placeholder="Re-enter your password" 
                               autocomplete="new-password"
                               class="w-full pl-10 pr-4 py-2.5 text-sm bg-background border border-border rounded-custom-sm focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary text-foreground placeholder:text-muted-foreground transition-all" />
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                <div class="pt-2">
                    <button type="submit" 
                            class="w-full py-3 px-4 text-sm font-semibold text-white bg-primary hover:opacity-90 active:scale-95 rounded-custom-sm shadow-md shadow-primary/25 transition-all flex items-center justify-center gap-2 cursor-pointer">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" x2="19" y1="8" y2="14"/><line x1="22" x2="16" y1="11" y2="11"/></svg>
                        <span>Create Account</span>
                    </button>
                </div>
            </form>

            <div class="mt-6 pt-5 border-t border-border text-center text-xs text-muted-foreground">
                Already have an account? 
                <a asp-page="/Account/Login" asp-route-returnUrl="@Model.ReturnUrl" class="font-bold text-primary hover:underline ml-1">
                    Sign in here &rarr;
                </a>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
