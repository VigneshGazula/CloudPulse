@page
@model IndexModel
@{
    ViewData["Title"] = "Step Into Style - Premium Footwear Collection";
}

<!-- Notification Toast / Status Message -->
@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div id="status-toast" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
        <div class="p-4 rounded-custom-sm bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-sm font-semibold flex items-center justify-between shadow-xs">
            <div class="flex items-center gap-2.5">
                <svg class="w-5 h-5 text-emerald-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>
                <span>@Model.StatusMessage</span>
            </div>
            <button type="button" onclick="document.getElementById('status-toast').remove()" class="text-foreground/50 hover:text-foreground">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            </button>
        </div>
    </div>
}

<!-- Centered Hero Section -->
<section class="relative overflow-hidden bg-gradient-to-b from-primary/10 via-background to-background py-16 sm:py-24 border-b border-border/40">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <!-- Pill Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary/10 border border-primary/25 text-primary text-xs font-bold uppercase tracking-wider mb-6">
            <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
            Spring &amp; Summer Edition
        </div>

        <!-- Heading: "Step Into Style" -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-foreground leading-tight">
            Step Into <span class="text-primary underline decoration-primary/40 underline-offset-8">Style</span>
        </h1>

        <!-- Subtext -->
        <p class="mt-5 text-base sm:text-lg text-muted-foreground max-w-2xl mx-auto leading-relaxed">
            Discover precision-crafted footwear engineered for seamless transitions from urban commutes to weekend adventures. Unrivaled comfort meets modern silhouette design.
        </p>

        <!-- Category Filters -->
        <div class="mt-8 flex flex-wrap items-center justify-center gap-2">
            <a asp-page="/Index" 
               asp-route-SelectedCategory="All" 
               class="px-4 py-2 text-xs sm:text-sm font-semibold rounded-full border transition-all @(string.IsNullOrEmpty(Model.SelectedCategory) || Model.SelectedCategory.Equals("All", StringComparison.OrdinalIgnoreCase) ? "bg-primary text-white border-primary shadow-xs" : "bg-card border-border text-foreground hover:bg-muted")">
                All Footwear (@Model.Products.Count)
            </a>
            @foreach (var cat in Model.Categories)
            {
                var isSelected = string.Equals(Model.SelectedCategory, cat, StringComparison.OrdinalIgnoreCase);
                <a asp-page="/Index" 
                   asp-route-SelectedCategory="@cat" 
                   class="px-4 py-2 text-xs sm:text-sm font-semibold rounded-full border transition-all @(isSelected ? "bg-primary text-white border-primary shadow-xs" : "bg-card border-border text-foreground hover:bg-muted")">
                    @cat
                </a>
            }
        </div>
    </div>
</section>

<!-- Product Catalog Section -->
<section id="products-catalog" class="py-12 sm:py-20 bg-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Results Meta Bar -->
        <div class="flex items-center justify-between mb-8 pb-4 border-b border-border/60">
            <div>
                <p class="text-xs uppercase font-bold tracking-wider text-muted-foreground">
                    @if (!string.IsNullOrEmpty(Model.Q))
                    {
                        <span>Search Results</span>
                    }
                    else
                    {
                        <span>Showing Collection</span>
                    }
                </p>
                <div class="flex items-center gap-3">
                    <h2 class="text-xl font-extrabold text-foreground tracking-tight">
                        @if (!string.IsNullOrEmpty(Model.Q))
                        {
                            <span>Results for "@Model.Q"</span>
                        }
                        else
                        {
                            @((string.IsNullOrEmpty(Model.SelectedCategory) || Model.SelectedCategory.Equals("All", StringComparison.OrdinalIgnoreCase)) ? "All Curated Footwear" : Model.SelectedCategory)
                        }
                    </h2>
                    @if (!string.IsNullOrEmpty(Model.Q) || (!string.IsNullOrEmpty(Model.SelectedCategory) && !Model.SelectedCategory.Equals("All", StringComparison.OrdinalIgnoreCase)))
                    {
                        <a asp-page="/Index" class="text-xs font-semibold text-primary hover:underline">Clear filter</a>
                    }
                </div>
            </div>
            <span class="text-xs sm:text-sm font-medium text-muted-foreground">
                @Model.Products.Count products found
            </span>
        </div>

        <!-- Responsive Product Grid (1 / 2 / 3 columns) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
            @foreach (var product in Model.Products)
            {
                <!-- Product Card -->
                <div class="group relative rounded-custom bg-card border border-border overflow-hidden hover:shadow-xl hover:border-primary/40 transition-all duration-300 flex flex-col justify-between">
                    
                    <!-- Top Visual & Actions -->
                    <div class="relative overflow-hidden bg-muted aspect-[4/3] w-full">
                        <!-- Product Image linking to /product/{id} -->
                        <a href="/product/@product.Id" class="block w-full h-full overflow-hidden">
                            <img src="@product.ImageUrl" 
                                 alt="@product.Name" 
                                 loading="lazy"
                                 class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500 ease-out" />
                        </a>

                        <!-- Category Badge -->
                        @if (!string.IsNullOrEmpty(product.Category))
                        {
                            <span class="absolute top-3 left-3 px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider bg-background/90 backdrop-blur-md border border-border/80 rounded-full text-foreground shadow-2xs">
                                @product.Category
                            </span>
                        }

                        <!-- Heart / Like Icon on Hover -->
                        <button type="button" 
                                onclick="toggleWishlist(this, @product.Id)"
                                class="like-button absolute top-3 right-3 w-9 h-9 rounded-full bg-background/90 backdrop-blur-md border border-border/80 flex items-center justify-center text-muted-foreground hover:text-red-500 opacity-0 group-hover:opacity-100 transition-all duration-200 shadow-2xs hover:scale-110 active:scale-95 focus:opacity-100"
                                aria-label="Save @product.Name to Wishlist" 
                                title="Save to wishlist">
                            <svg class="w-5 h-5 transition-colors fill-transparent stroke-current" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
                            </svg>
                        </button>
                    </div>

                    <!-- Card Body -->
                    <div class="p-5 sm:p-6 flex flex-col flex-1 justify-between">
                        <div>
                            <!-- Product Name linking to /product/{id} -->
                            <h3 class="text-lg font-bold text-card-foreground group-hover:text-primary transition-colors tracking-tight line-clamp-1">
                                <a href="/product/@product.Id" class="focus:outline-none">
                                    @product.Name
                                </a>
                            </h3>

                            <!-- Description -->
                            <p class="mt-2 text-xs sm:text-sm text-muted-foreground line-clamp-2 leading-relaxed">
                                @product.Description
                            </p>
                        </div>

                        <!-- Price and Add to Cart Section -->
                        <div class="mt-5 pt-4 border-t border-border flex items-center justify-between gap-3">
                            <div class="flex flex-col">
                                <span class="text-[10px] uppercase font-bold text-muted-foreground">Price</span>
                                <span class="text-xl sm:text-2xl font-black text-foreground">
                                    $@product.Price.ToString("F2")
                                </span>
                            </div>

                            <!-- Add to Cart Button with Hover State -->
                            <form method="post" asp-page-handler="AddToCart" class="add-to-cart-form shrink-0">
                                <input type="hidden" name="productId" value="@product.Id" />
                                <button type="submit" 
                                        class="px-4 py-2.5 text-xs sm:text-sm font-semibold text-white bg-primary hover:opacity-90 active:scale-95 rounded-custom-sm shadow-sm hover:shadow-md transition-all flex items-center gap-1.5 cursor-pointer">
                                    <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
                                        <path d="M3 6h18"/>
                                        <path d="M16 10a4 4 0 0 1-8 0"/>
                                    </svg>
                                    <span>Add to Cart</span>
                                </button>
                            </form>
                        </div>

                    </div>
                </div>
            }
        </div>

        @if (!Model.Products.Any())
        {
            <div class="text-center py-20 bg-card border border-border rounded-custom p-8">
                <svg class="w-12 h-12 text-muted-foreground mx-auto mb-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>
                <h3 class="text-lg font-bold text-foreground">No products found</h3>
                <p class="text-sm text-muted-foreground mt-1">Try selecting a different category or clearing your filters.</p>
                <a asp-page="/Index" class="inline-block mt-4 px-4 py-2 text-sm font-semibold text-primary border border-primary/30 rounded-custom-sm hover:bg-primary/10">
                    View All Products
                </a>
            </div>
        }

    </div>
</section>

<!-- Wishlist and AJAX Cart Helper Script -->
@section Scripts {
    <script>
        function toggleWishlist(btn, productId) {
            const svg = btn.querySelector('svg');
            const isLiked = svg.classList.contains('fill-red-500');
            if (isLiked) {
                svg.classList.remove('fill-red-500', 'text-red-500');
                svg.classList.add('fill-transparent');
            } else {
                svg.classList.add('fill-red-500', 'text-red-500');
                svg.classList.remove('fill-transparent');
            }
        }

        // Intercept Add to Cart form submissions for instant dynamic update
        document.querySelectorAll('.add-to-cart-form').forEach(form => {
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const formData = new FormData(form);
                const button = form.querySelector('button[type="submit"]');
                const originalHtml = button.innerHTML;

                button.disabled = true;
                button.innerHTML = `<svg class="w-4 h-4 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" stroke-dasharray="32" stroke-dashoffset="12"/></svg> <span>Adding...</span>`;

                try {
                    const response = await fetch(form.action || window.location.href, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    if (response.ok) {
                        const data = await response.json();
                        // Update cart badge in header
                        const cartBadge = document.querySelector('header a[href="#cart"] span, header a[aria-label*="Cart"] span');
                        if (cartBadge && data.cartCount !== undefined) {
                            cartBadge.textContent = data.cartCount;
                            cartBadge.classList.add('scale-125');
                            setTimeout(() => cartBadge.classList.remove('scale-125'), 300);
                        }

                        button.innerHTML = `<svg class="w-4 h-4 text-emerald-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg> <span>Added!</span>`;
                        setTimeout(() => {
                            button.innerHTML = originalHtml;
                            button.disabled = false;
                        }, 1800);
                    } else {
                        form.submit(); // fallback to normal form post
                    }
                } catch {
                    form.submit();
                }
            });
        });
    </script>
}
