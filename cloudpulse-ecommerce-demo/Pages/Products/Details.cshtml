@page "/product/{id:int}"
@model cloudpulse_ecommerce_demo.Pages.Products.DetailsModel
@{
    if (Model.Product != null)
    {
        ViewData["Title"] = $"{Model.Product.Name} - CLOUDPULSE";
    }
    else
    {
        ViewData["Title"] = "Product Not Found - CLOUDPULSE";
    }
}

@if (Model.Product == null)
{
    <!-- 404 Fallback View: ProductNotFound.tsx Replica -->
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-28 text-center">
        <div class="w-20 h-20 mx-auto rounded-full bg-primary/10 text-primary flex items-center justify-center mb-6 shadow-sm">
            <svg class="w-10 h-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/>
                <path d="m21 21-4.3-4.3"/>
                <path d="M9 9l4 4"/>
                <path d="M13 9l-4 4"/>
            </svg>
        </div>
        <span class="inline-block px-3 py-1 text-xs font-bold uppercase tracking-wider text-primary bg-primary/10 rounded-full mb-3">
            Error 404
        </span>
        <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-foreground">
            Product Not Found
        </h1>
        <p class="mt-4 text-base text-muted-foreground max-w-md mx-auto leading-relaxed">
            The product you're looking for doesn't exist, has been moved, or the link might be broken.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
            <a asp-page="/Index" class="px-6 py-3 text-sm font-semibold text-white bg-primary hover:opacity-90 active:scale-95 rounded-custom shadow-md shadow-primary/20 transition-all flex items-center gap-2">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
                <span>Return to Catalog</span>
            </a>
            <a href="/#products-catalog" class="px-6 py-3 text-sm font-semibold text-foreground bg-muted hover:bg-muted/80 rounded-custom border border-border transition-all">
                Browse Footwear
            </a>
        </div>
    </div>
}
else
{
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
        
        <!-- Breadcrumb Trail: ProductBreadcrumb.tsx Replica -->
        <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs sm:text-sm text-muted-foreground mb-8 overflow-x-auto whitespace-nowrap">
            <a asp-page="/Index" class="hover:text-primary transition-colors flex items-center gap-1.5">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                <span>Home</span>
            </a>
            <span class="text-border">/</span>
            @if (!string.IsNullOrEmpty(Model.Product.Category))
            {
                <a asp-page="/Index" asp-route-SelectedCategory="@Model.Product.Category" class="hover:text-primary transition-colors">
                    @Model.Product.Category
                </a>
                <span class="text-border">/</span>
            }
            <span class="text-foreground font-semibold truncate max-w-xs sm:max-w-md">
                @Model.Product.Name
            </span>
        </nav>

        <!-- Status / Alert message -->
        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
            <div id="details-toast" class="mb-6 p-4 rounded-custom-sm bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-sm font-medium flex items-center justify-between shadow-xs">
                <div class="flex items-center gap-2.5">
                    <svg class="w-5 h-5 text-emerald-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>
                    <span>@Model.StatusMessage</span>
                </div>
                <button type="button" onclick="document.getElementById('details-toast').remove()" class="text-foreground/50 hover:text-foreground">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                </button>
            </div>
        }

        <!-- Product Main Showcase: 2 Columns (Image Left, Details Right) -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-start">
            
            <!-- Left Column: Large Product Image -->
            <div class="space-y-4">
                <div class="relative overflow-hidden rounded-custom bg-muted border border-border group shadow-sm aspect-[4/3] sm:aspect-square">
                    <img id="main-product-image"
                         src="@Model.Product.ImageUrl" 
                         alt="@Model.Product.Name" 
                         class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500 ease-out" />
                    
                    @if (!string.IsNullOrEmpty(Model.Product.Category))
                    {
                        <span class="absolute top-4 left-4 px-3 py-1 text-xs font-bold uppercase tracking-wider bg-background/90 backdrop-blur-md border border-border/80 rounded-full text-foreground shadow-2xs">
                            @Model.Product.Category
                        </span>
                    }

                    <div class="absolute bottom-4 left-4 inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-background/90 backdrop-blur-md border border-border/80 text-[11px] font-semibold text-foreground shadow-2xs">
                        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                        Authentic Artisan Series
                    </div>
                </div>

                <!-- Thumbnail strip placeholder -->
                <div class="grid grid-cols-4 gap-3">
                    <div class="border-2 border-primary rounded-custom-sm overflow-hidden aspect-square bg-muted cursor-pointer shadow-2xs">
                        <img src="@Model.Product.ImageUrl" alt="Main view" class="w-full h-full object-cover" />
                    </div>
                    <div class="border border-border hover:border-primary/50 rounded-custom-sm overflow-hidden aspect-square bg-muted cursor-pointer opacity-80 hover:opacity-100 transition-opacity">
                        <img src="@Model.Product.ImageUrl" alt="Angle view" class="w-full h-full object-cover brightness-95" />
                    </div>
                    <div class="border border-border hover:border-primary/50 rounded-custom-sm overflow-hidden aspect-square bg-muted cursor-pointer opacity-80 hover:opacity-100 transition-opacity">
                        <img src="@Model.Product.ImageUrl" alt="Detail view" class="w-full h-full object-cover contrast-105" />
                    </div>
                    <div class="border border-border hover:border-primary/50 rounded-custom-sm overflow-hidden aspect-square bg-muted cursor-pointer opacity-80 hover:opacity-100 transition-opacity">
                        <img src="@Model.Product.ImageUrl" alt="Sole view" class="w-full h-full object-cover brightness-90" />
                    </div>
                </div>
            </div>

            <!-- Right Column: Details & Interaction Controls -->
            <div class="space-y-6">
                <div>
                    <!-- Category / SKU -->
                    <p class="text-xs uppercase font-extrabold tracking-wider text-primary">
                        @(Model.Product.Category ?? "Footwear") • SKU #BLM-00@(Model.Product.Id)
                    </p>

                    <!-- Product Name -->
                    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-foreground mt-2 leading-tight">
                        @Model.Product.Name
                    </h1>

                    <!-- Star-Rating Placeholder & Stock Status -->
                    <div class="flex flex-wrap items-center gap-3 mt-3 pt-1">
                        <!-- 5 Stars Placeholder -->
                        <div class="flex items-center gap-1 text-amber-400" aria-label="Rating: 4.9 out of 5 stars">
                            @for (int i = 0; i < 5; i++)
                            {
                                <svg class="w-4 h-4 fill-amber-400 stroke-amber-400" viewBox="0 0 24 24">
                                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                                </svg>
                            }
                        </div>
                        <span class="text-xs font-semibold text-foreground">4.9</span>
                        <span class="text-xs text-muted-foreground">(142 verified reviews)</span>
                        <span class="text-border">|</span>
                        <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-600 dark:text-emerald-400">
                            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                            In Stock • Ready to Ship
                        </span>
                    </div>

                    <!-- Price -->
                    <div class="mt-5 flex items-baseline gap-3">
                        <span class="text-3xl sm:text-4xl font-black text-foreground tracking-tight">
                            $@Model.Product.Price.ToString("F2")
                        </span>
                        <span class="text-sm text-muted-foreground line-through">
                            $@((Model.Product.Price * 1.25m).ToString("F2"))
                        </span>
                        <span class="px-2 py-0.5 text-xs font-bold text-emerald-700 dark:text-emerald-300 bg-emerald-100 dark:bg-emerald-950/50 rounded-full">
                            Save 20%
                        </span>
                    </div>
                </div>

                <!-- Description -->
                <div class="pt-2 border-t border-border">
                    <p class="text-sm sm:text-base text-muted-foreground leading-relaxed">
                        @Model.Product.Description
                    </p>
                </div>

                <!-- Size Selector Placeholder (Common for Footwear / Style) -->
                <div class="space-y-2">
                    <div class="flex items-center justify-between text-xs font-bold uppercase tracking-wider text-muted-foreground">
                        <span>Select Size (US)</span>
                        <a href="#size-guide" class="text-primary hover:underline lowercase font-normal">Size guide</a>
                    </div>
                    <div class="grid grid-cols-5 gap-2">
                        @foreach (var size in new[] { "8.0", "9.0", "10.0", "10.5", "11.0" })
                        {
                            <button type="button" 
                                    onclick="selectSize(this)" 
                                    class="size-pill py-2 text-xs font-semibold rounded-custom-sm border border-border text-foreground hover:border-primary hover:text-primary transition-all @(size == "10.0" ? "border-primary bg-primary/10 text-primary font-bold ring-1 ring-primary" : "bg-card")">
                                @size
                            </button>
                        }
                    </div>
                </div>

                <!-- Quantity Selector and Action Buttons Form -->
                <form id="product-action-form" method="post" class="space-y-4 pt-2 border-t border-border">
                    <input type="hidden" name="id" value="@Model.Product.Id" />
                    
                    <!-- Quantity Selector with +/- buttons -->
                    <div class="flex items-center gap-4">
                        <label for="qty-input" class="text-xs font-bold uppercase tracking-wider text-muted-foreground">
                            Quantity
                        </label>
                        <div class="inline-flex items-center rounded-custom-sm border border-border bg-card shadow-2xs">
                            <button type="button" 
                                    id="qty-minus" 
                                    class="w-10 h-10 flex items-center justify-center text-foreground hover:bg-muted active:scale-95 transition-all text-base font-bold focus:outline-none"
                                    aria-label="Decrease quantity">
                                &minus;
                            </button>
                            <input type="number" 
                                   id="qty-input" 
                                   name="quantity" 
                                   value="1" 
                                   min="1" 
                                   max="99" 
                                   class="w-12 h-10 text-center text-sm font-bold text-foreground bg-transparent focus:outline-none [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none" />
                            <button type="button" 
                                    id="qty-plus" 
                                    class="w-10 h-10 flex items-center justify-center text-foreground hover:bg-muted active:scale-95 transition-all text-base font-bold focus:outline-none"
                                    aria-label="Increase quantity">
                                &#43;
                            </button>
                        </div>
                        <span class="text-xs text-muted-foreground">Only 6 pairs remaining</span>
                    </div>

                    <!-- "Add to Cart" and "Buy Now" Buttons -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
                        <!-- Add to Cart Button -->
                        <button type="submit" 
                                id="btn-add-to-cart"
                                asp-page-handler="AddToCart"
                                class="w-full py-3.5 px-6 text-sm sm:text-base font-semibold text-white bg-primary hover:opacity-90 active:scale-95 rounded-custom-sm shadow-md shadow-primary/20 transition-all flex items-center justify-center gap-2 cursor-pointer">
                            <svg id="icon-cart" class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
                                <path d="M3 6h18"/>
                                <path d="M16 10a4 4 0 0 1-8 0"/>
                            </svg>
                            <span id="btn-cart-text">Add to Cart</span>
                        </button>

                        <!-- Buy Now Button -->
                        <button type="submit" 
                                id="btn-buy-now"
                                asp-page-handler="BuyNow"
                                class="w-full py-3.5 px-6 text-sm sm:text-base font-semibold text-background bg-foreground hover:bg-foreground/90 active:scale-95 rounded-custom-sm shadow-sm transition-all flex items-center justify-center gap-2 cursor-pointer">
                            <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="m13 2-2 10h7L9 22l2-10H4z"/>
                            </svg>
                            <span>Buy Now</span>
                        </button>
                    </div>
                </form>

                <!-- Quick Highlights Box -->
                <div class="p-4 rounded-custom bg-muted/60 border border-border space-y-2.5 text-xs text-muted-foreground">
                    <div class="flex items-center gap-2 text-foreground font-medium">
                        <svg class="w-4 h-4 text-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>
                        <span>Complimentary express delivery on orders over $65</span>
                    </div>
                    <div class="flex items-center gap-2 text-foreground font-medium">
                        <svg class="w-4 h-4 text-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>
                        <span>Free 30-day wear-test returns with prepaid label</span>
                    </div>
                    <div class="flex items-center gap-2 text-foreground font-medium">
                        <svg class="w-4 h-4 text-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>
                        <span>Zero carbon footprint sustainable packaging</span>
                    </div>
                </div>

            </div>
        </div>

        <!-- Features Section: Features.tsx Replica -->
        <section class="mt-20 pt-16 border-t border-border">
            <div class="text-center max-w-2xl mx-auto mb-12">
                <span class="text-xs font-bold uppercase tracking-wider text-primary">Uncompromising Craft</span>
                <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-foreground mt-1">
                    Engineered for Precision &amp; Everyday Allure
                </h2>
                <p class="mt-2 text-sm text-muted-foreground">
                    Every seam, sole contour, and textile is purposefully selected to ensure extraordinary longevity and weightless ease.
                </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                <!-- Feature 1 -->
                <div class="rounded-custom bg-card border border-border p-6 shadow-2xs hover:shadow-md transition-shadow">
                    <div class="w-12 h-12 rounded-custom-sm bg-primary/10 text-primary flex items-center justify-center mb-4">
                        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    </div>
                    <h3 class="text-base font-bold text-card-foreground">Premium Materials</h3>
                    <p class="text-xs text-muted-foreground mt-2 leading-relaxed">
                        Hand-selected full-grain leathers and technical knit textiles sourced from gold-rated environmental tanneries.
                    </p>
                </div>

                <!-- Feature 2 -->
                <div class="rounded-custom bg-card border border-border p-6 shadow-2xs hover:shadow-md transition-shadow">
                    <div class="w-12 h-12 rounded-custom-sm bg-secondary text-primary flex items-center justify-center mb-4">
                        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 4.24 4.24"/></svg>
                    </div>
                    <h3 class="text-base font-bold text-card-foreground">Ergonomic Arch Support</h3>
                    <p class="text-xs text-muted-foreground mt-2 leading-relaxed">
                        Dual-density high-rebound cushioning with sculpted footbed that adapts to your natural biomechanical stride.
                    </p>
                </div>

                <!-- Feature 3 -->
                <div class="rounded-custom bg-card border border-border p-6 shadow-2xs hover:shadow-md transition-shadow">
                    <div class="w-12 h-12 rounded-custom-sm bg-primary/10 text-primary flex items-center justify-center mb-4">
                        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
                    </div>
                    <h3 class="text-base font-bold text-card-foreground">Low Impact Footprint</h3>
                    <p class="text-xs text-muted-foreground mt-2 leading-relaxed">
                        Constructed using over 40% recycled polymers and solvent-free water-based adhesives.
                    </p>
                </div>

                <!-- Feature 4 -->
                <div class="rounded-custom bg-card border border-border p-6 shadow-2xs hover:shadow-md transition-shadow">
                    <div class="w-12 h-12 rounded-custom-sm bg-secondary text-primary flex items-center justify-center mb-4">
                        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </div>
                    <h3 class="text-base font-bold text-card-foreground">Risk-Free 30 Days</h3>
                    <p class="text-xs text-muted-foreground mt-2 leading-relaxed">
                        Wear them, walk them, live in them. If they aren't your most comfortable pair, return for a 100% full refund.
                    </p>
                </div>
            </div>
        </section>

        <!-- Related Products Section: RelatedProducts.tsx Replica -->
        @if (Model.RelatedProducts.Any())
        {
            <section class="mt-20 pt-16 border-t border-border">
                <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
                    <div>
                        <span class="text-xs font-bold uppercase tracking-wider text-primary">Curated For You</span>
                        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-foreground mt-1">
                            You Might Also Like
                        </h2>
                    </div>
                    <a asp-page="/Index" class="text-sm font-semibold text-primary hover:underline flex items-center gap-1">
                        <span>View complete catalog</span>
                        <span>&rarr;</span>
                    </a>
                </div>

                <!-- 4-Product Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                    @foreach (var item in Model.RelatedProducts)
                    {
                        <div class="group relative rounded-custom bg-card border border-border overflow-hidden hover:shadow-lg hover:border-primary/40 transition-all flex flex-col justify-between">
                            <div class="relative overflow-hidden bg-muted aspect-[4/3] w-full">
                                <a href="/product/@item.Id" class="block w-full h-full">
                                    <img src="@item.ImageUrl" 
                                         alt="@item.Name" 
                                         loading="lazy" 
                                         class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500 ease-out" />
                                </a>
                                @if (!string.IsNullOrEmpty(item.Category))
                                {
                                    <span class="absolute top-2.5 left-2.5 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider bg-background/90 backdrop-blur-md border border-border/80 rounded-full text-foreground shadow-2xs">
                                        @item.Category
                                    </span>
                                }
                            </div>
                            <div class="p-4 flex flex-col flex-1 justify-between">
                                <div>
                                    <h3 class="text-sm font-bold text-card-foreground group-hover:text-primary transition-colors line-clamp-1">
                                        <a href="/product/@item.Id">@item.Name</a>
                                    </h3>
                                    <p class="text-xs text-muted-foreground line-clamp-2 mt-1">
                                        @item.Description
                                    </p>
                                </div>
                                <div class="mt-4 pt-3 border-t border-border flex items-center justify-between">
                                    <span class="text-base font-bold text-foreground">$@item.Price.ToString("F2")</span>
                                    <a href="/product/@item.Id" class="text-xs font-semibold text-primary hover:underline">
                                        View &rarr;
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>
        }

    </div>
}

@section Scripts {
    <script>
        // Quantity +/- selector (vanilla JS)
        const qtyInput = document.getElementById('qty-input');
        const qtyMinus = document.getElementById('qty-minus');
        const qtyPlus = document.getElementById('qty-plus');

        if (qtyInput && qtyMinus && qtyPlus) {
            qtyMinus.addEventListener('click', () => {
                let current = parseInt(qtyInput.value) || 1;
                if (current > 1) {
                    qtyInput.value = current - 1;
                }
            });

            qtyPlus.addEventListener('click', () => {
                let current = parseInt(qtyInput.value) || 1;
                if (current < 99) {
                    qtyInput.value = current + 1;
                }
            });
        }

        // Size pill selection
        function selectSize(btn) {
            document.querySelectorAll('.size-pill').forEach(b => {
                b.classList.remove('border-primary', 'bg-primary/10', 'text-primary', 'font-bold', 'ring-1', 'ring-primary');
                b.classList.add('bg-card');
            });
            btn.classList.remove('bg-card');
            btn.classList.add('border-primary', 'bg-primary/10', 'text-primary', 'font-bold', 'ring-1', 'ring-primary');
        }

        // Add to Cart and Buy Now loading/success states
        const actionForm = document.getElementById('product-action-form');
        const btnAddToCart = document.getElementById('btn-add-to-cart');
        const btnBuyNow = document.getElementById('btn-buy-now');
        const btnCartText = document.getElementById('btn-cart-text');
        const iconCart = document.getElementById('icon-cart');

        if (actionForm && btnAddToCart) {
            btnAddToCart.addEventListener('click', async (e) => {
                e.preventDefault();
                const formData = new FormData(actionForm);
                const originalText = btnCartText ? btnCartText.textContent : 'Add to Cart';

                btnAddToCart.disabled = true;
                if (btnCartText) btnCartText.textContent = 'Adding...';
                if (iconCart) {
                    iconCart.innerHTML = `<circle cx="12" cy="12" r="10" stroke-dasharray="32" stroke-dashoffset="12" class="animate-spin"/>`;
                }

                try {
                    const response = await fetch('?handler=AddToCart', {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    if (response.ok) {
                        const data = await response.json();
                        // Update cart badge in header
                        const cartBadge = document.querySelector('.cart-badge');
                        if (cartBadge && data.cartCount !== undefined) {
                            cartBadge.textContent = data.cartCount;
                            cartBadge.classList.add('scale-125');
                            setTimeout(() => cartBadge.classList.remove('scale-125'), 300);
                        }

                        if (btnCartText) btnCartText.textContent = 'Added to Cart!';
                        if (iconCart) {
                            iconCart.innerHTML = `<path d="M20 6 9 17l-5-5"/>`;
                        }

                        setTimeout(() => {
                            if (btnCartText) btnCartText.textContent = originalText;
                            if (iconCart) {
                                iconCart.innerHTML = `<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>`;
                            }
                            btnAddToCart.disabled = false;
                        }, 2000);
                    } else {
                        actionForm.action = '?handler=AddToCart';
                        actionForm.submit();
                    }
                } catch {
                    actionForm.action = '?handler=AddToCart';
                    actionForm.submit();
                }
            });
        }
    </script>
}
