@page "/contact"
@model cloudpulse_ecommerce_demo.Pages.ContactModel
@{
    ViewData["Title"] = "Contact Us - CLOUDPULSE Concierge";
}

<!-- Hero Section with Gradient Background -->
<section class="relative overflow-hidden bg-gradient-to-b from-primary/10 via-background to-background py-16 sm:py-24 border-b border-border/40">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <!-- Badge: "Get in Touch" -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary/10 border border-primary/25 text-primary text-xs font-bold uppercase tracking-wider mb-5">
            <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
            Get in Touch
        </div>

        <!-- Heading -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-foreground leading-tight">
            We'd Love to Hear <span class="text-primary underline decoration-primary/40 underline-offset-8">From You</span>
        </h1>

        <!-- Subtext -->
        <p class="mt-5 text-base sm:text-lg text-muted-foreground max-w-2xl mx-auto leading-relaxed">
            Have questions about sizing, ergonomic cushioning, material craftsmanship, or an ongoing order? Our dedicated footwear specialists are standing by.
        </p>
    </div>
</section>

<!-- Main Two-Column Section: Form (Left) & Sidebar (Right) -->
<section class="py-12 sm:py-20 bg-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Status Toast from TempData -->
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div id="contact-alert" class="mb-8 p-4 rounded-custom-sm bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-sm font-semibold flex items-center justify-between shadow-xs">
                <div class="flex items-center gap-2.5">
                    <svg class="w-5 h-5 text-emerald-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>
                    <span>@Model.SuccessMessage</span>
                </div>
                <button type="button" onclick="document.getElementById('contact-alert').remove()" class="text-foreground/50 hover:text-foreground">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                </button>
            </div>
        }

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
            
            <!-- Left Column: Contact Form -->
            <div class="lg:col-span-7">
                <div class="rounded-custom bg-card border border-border p-6 sm:p-10 shadow-sm">
                    <div class="mb-8">
                        <span class="text-xs font-bold uppercase tracking-wider text-primary">Direct Inquiry</span>
                        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-card-foreground mt-1">
                            Send Us a Message
                        </h2>
                        <p class="text-sm text-muted-foreground mt-1.5">
                            Fill out the details below and a concierge specialist will respond within 24 business hours.
                        </p>
                    </div>

                    <!-- Client-side notification alert -->
                    <div id="js-contact-alert" class="hidden mb-6 p-4 rounded-custom-sm bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-sm font-semibold flex items-center gap-2.5 shadow-xs">
                        <svg class="w-5 h-5 text-emerald-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>
                        <span id="js-alert-text">Message sent successfully!</span>
                    </div>

                    <form id="contact-form" method="post" class="space-y-5">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                            <!-- Name -->
                            <div>
                                <label asp-for="ContactForm.Name" class="block text-xs font-bold uppercase tracking-wider text-foreground mb-1.5">
                                    Full Name <span class="text-primary">*</span>
                                </label>
                                <input asp-for="ContactForm.Name" 
                                       required
                                       placeholder="e.g. Jane Doe"
                                       class="w-full px-4 py-3 text-sm bg-background border border-border rounded-custom-sm focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary text-foreground placeholder:text-muted-foreground transition-all" />
                                <span asp-validation-for="ContactForm.Name" class="text-xs text-red-500 mt-1 block"></span>
                            </div>

                            <!-- Email -->
                            <div>
                                <label asp-for="ContactForm.Email" class="block text-xs font-bold uppercase tracking-wider text-foreground mb-1.5">
                                    Email Address <span class="text-primary">*</span>
                                </label>
                                <input asp-for="ContactForm.Email" 
                                       type="email"
                                       required
                                       placeholder="e.g. jane@example.com"
                                       class="w-full px-4 py-3 text-sm bg-background border border-border rounded-custom-sm focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary text-foreground placeholder:text-muted-foreground transition-all" />
                                <span asp-validation-for="ContactForm.Email" class="text-xs text-red-500 mt-1 block"></span>
                            </div>
                        </div>

                        <!-- Subject -->
                        <div>
                            <label asp-for="ContactForm.Subject" class="block text-xs font-bold uppercase tracking-wider text-foreground mb-1.5">
                                Subject <span class="text-primary">*</span>
                            </label>
                            <input asp-for="ContactForm.Subject" 
                                   required
                                   placeholder="e.g. Sizing Advice, Order Inquiry, Custom Collaboration"
                                   class="w-full px-4 py-3 text-sm bg-background border border-border rounded-custom-sm focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary text-foreground placeholder:text-muted-foreground transition-all" />
                            <span asp-validation-for="ContactForm.Subject" class="text-xs text-red-500 mt-1 block"></span>
                        </div>

                        <!-- Message -->
                        <div>
                            <label asp-for="ContactForm.Message" class="block text-xs font-bold uppercase tracking-wider text-foreground mb-1.5">
                                Message <span class="text-primary">*</span>
                            </label>
                            <textarea asp-for="ContactForm.Message" 
                                      rows="5"
                                      required
                                      placeholder="How can our concierge team assist you today? Please include order number if applicable."
                                      class="w-full px-4 py-3 text-sm bg-background border border-border rounded-custom-sm focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary text-foreground placeholder:text-muted-foreground transition-all resize-none"></textarea>
                            <span asp-validation-for="ContactForm.Message" class="text-xs text-red-500 mt-1 block"></span>
                        </div>

                        <!-- Submit Button with Sending/Sent states via minimal vanilla JS -->
                        <div class="pt-2">
                            <button type="submit" 
                                    id="btn-submit-contact"
                                    class="w-full sm:w-auto px-8 py-3.5 text-sm sm:text-base font-semibold text-white bg-primary hover:opacity-90 active:scale-95 rounded-custom-sm shadow-md shadow-primary/20 transition-all flex items-center justify-center gap-2.5 cursor-pointer">
                                <svg id="submit-icon" class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="22" x2="11" y1="2" y2="13"/>
                                    <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                                </svg>
                                <span id="submit-text">Send Message</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Right Column: Sidebar (Contact Info + Why Contact Us) -->
            <div class="lg:col-span-5 space-y-6">
                
                <!-- Card 1: Contact Information Card -->
                <div class="rounded-custom bg-card border border-border p-6 sm:p-8 shadow-sm space-y-6">
                    <div>
                        <span class="text-xs font-bold uppercase tracking-wider text-primary">Direct Channels</span>
                        <h3 class="text-xl font-bold text-card-foreground mt-1">Contact Information</h3>
                    </div>

                    <div class="space-y-4 text-sm">
                        <!-- Email -->
                        <div class="flex items-start gap-3.5">
                            <div class="w-10 h-10 rounded-custom-sm bg-primary/10 text-primary flex items-center justify-center shrink-0">
                                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                            </div>
                            <div>
                                <p class="text-xs text-muted-foreground uppercase font-semibold">Email Concierge</p>
                                <a href="mailto:concierge@cloudpulse.com" class="font-bold text-foreground hover:text-primary transition-colors">
                                    concierge@cloudpulse.com
                                </a>
                                <p class="text-xs text-muted-foreground">Average reply time: under 4 hours</p>
                            </div>
                        </div>

                        <!-- Phone -->
                        <div class="flex items-start gap-3.5">
                            <div class="w-10 h-10 rounded-custom-sm bg-secondary text-primary flex items-center justify-center shrink-0">
                                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                            </div>
                            <div>
                                <p class="text-xs text-muted-foreground uppercase font-semibold">Toll-Free Phone</p>
                                <a href="tel:+18005557857" class="font-bold text-foreground hover:text-primary transition-colors">
                                    +1 (800) 555-PULSE
                                </a>
                                <p class="text-xs text-muted-foreground">Toll-free across North America</p>
                            </div>
                        </div>

                        <!-- Atelier Address -->
                        <div class="flex items-start gap-3.5">
                            <div class="w-10 h-10 rounded-custom-sm bg-primary/10 text-primary flex items-center justify-center shrink-0">
                                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                            </div>
                            <div>
                                <p class="text-xs text-muted-foreground uppercase font-semibold">Flagship Atelier &amp; Studio</p>
                                <p class="font-bold text-foreground">742 Evergreen Terrace</p>
                                <p class="text-xs text-muted-foreground">Design District, NY 10012</p>
                            </div>
                        </div>

                        <!-- Operating Hours -->
                        <div class="flex items-start gap-3.5">
                            <div class="w-10 h-10 rounded-custom-sm bg-secondary text-primary flex items-center justify-center shrink-0">
                                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                            </div>
                            <div>
                                <p class="text-xs text-muted-foreground uppercase font-semibold">Concierge Hours</p>
                                <p class="font-bold text-foreground">Mon – Fri: 8:00 AM – 8:00 PM EST</p>
                                <p class="text-xs text-muted-foreground">Sat – Sun: 10:00 AM – 6:00 PM EST</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Card 2: "Why Contact Us?" Card with 3 Feature Bullets -->
                <div class="rounded-custom bg-card border border-border p-6 sm:p-8 shadow-sm space-y-5">
                    <div>
                        <span class="text-xs font-bold uppercase tracking-wider text-primary">Tailored Service</span>
                        <h3 class="text-xl font-bold text-card-foreground mt-1">Why Contact Us?</h3>
                    </div>

                    <div class="space-y-4">
                        <!-- Bullet 1 -->
                        <div class="flex items-start gap-3">
                            <div class="w-6 h-6 rounded-full bg-primary/10 text-primary flex items-center justify-center shrink-0 mt-0.5">
                                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg>
                            </div>
                            <div>
                                <h4 class="text-sm font-bold text-foreground">Expert Sizing &amp; Fit Consultation</h4>
                                <p class="text-xs text-muted-foreground mt-0.5 leading-relaxed">
                                    Unsure between half-sizes or arch profiles? Our fit specialists provide tailored recommendations for zero blisters.
                                </p>
                            </div>
                        </div>

                        <!-- Bullet 2 -->
                        <div class="flex items-start gap-3">
                            <div class="w-6 h-6 rounded-full bg-primary/10 text-primary flex items-center justify-center shrink-0 mt-0.5">
                                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg>
                            </div>
                            <div>
                                <h4 class="text-sm font-bold text-foreground">Dedicated Order Concierge</h4>
                                <p class="text-xs text-muted-foreground mt-0.5 leading-relaxed">
                                    Real-time tracking, expedited delivery requests, gift notes, and white-glove packaging assistance.
                                </p>
                            </div>
                        </div>

                        <!-- Bullet 3 -->
                        <div class="flex items-start gap-3">
                            <div class="w-6 h-6 rounded-full bg-primary/10 text-primary flex items-center justify-center shrink-0 mt-0.5">
                                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg>
                            </div>
                            <div>
                                <h4 class="text-sm font-bold text-foreground">Bespoke &amp; Corporate Gifting</h4>
                                <p class="text-xs text-muted-foreground mt-0.5 leading-relaxed">
                                    Custom corporate botanical arrangements, bridal orders, or bulk luxury employee gifting with bespoke branding.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

        </div>

    </div>
</section>

<!-- FAQ Section: 4 Q&A Cards in a 2-Column Grid -->
<section class="py-16 sm:py-24 bg-muted/30 border-t border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
            <span class="text-xs font-bold uppercase tracking-wider text-primary">Quick Answers</span>
            <h2 class="text-3xl font-extrabold tracking-tight text-foreground mt-1">
                Frequently Asked Questions
            </h2>
            <p class="mt-2 text-sm text-muted-foreground">
                Find quick solutions to common inquiries regarding orders, sizing, shipping, and care.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 max-w-5xl mx-auto">
            
            <!-- FAQ 1 -->
            <div class="rounded-custom bg-card border border-border p-6 shadow-2xs hover:shadow-md hover:border-primary/40 transition-all">
                <div class="flex items-start gap-4">
                    <div class="w-8 h-8 rounded-full bg-primary/10 text-primary flex items-center justify-center shrink-0 font-black text-xs">
                        Q1
                    </div>
                    <div>
                        <h3 class="text-base font-bold text-card-foreground">
                            What is your return &amp; exchange policy?
                        </h3>
                        <p class="text-xs sm:text-sm text-muted-foreground mt-2 leading-relaxed">
                            We offer a risk-free 30-day wear-test guarantee on all footwear and non-perishable goods. If you aren't completely delighted, return for a full refund or free size exchange using our pre-paid shipping label.
                        </p>
                    </div>
                </div>
            </div>

            <!-- FAQ 2 -->
            <div class="rounded-custom bg-card border border-border p-6 shadow-2xs hover:shadow-md hover:border-primary/40 transition-all">
                <div class="flex items-start gap-4">
                    <div class="w-8 h-8 rounded-full bg-secondary text-primary flex items-center justify-center shrink-0 font-black text-xs">
                        Q2
                    </div>
                    <div>
                        <h3 class="text-base font-bold text-card-foreground">
                            How long does standard delivery take?
                        </h3>
                        <p class="text-xs sm:text-sm text-muted-foreground mt-2 leading-relaxed">
                            All orders are handcrafted and dispatched within 24 hours. Express transit takes 2-3 business days across the continental US and is complimentary on all orders over $50.
                        </p>
                    </div>
                </div>
            </div>

            <!-- FAQ 3 -->
            <div class="rounded-custom bg-card border border-border p-6 shadow-2xs hover:shadow-md hover:border-primary/40 transition-all">
                <div class="flex items-start gap-4">
                    <div class="w-8 h-8 rounded-full bg-secondary text-primary flex items-center justify-center shrink-0 font-black text-xs">
                        Q3
                    </div>
                    <div>
                        <h3 class="text-base font-bold text-card-foreground">
                            How do I track my active order?
                        </h3>
                        <p class="text-xs sm:text-sm text-muted-foreground mt-2 leading-relaxed">
                            The moment your package departs our atelier, you will receive an automated dispatch email with a direct tracking URL and real-time delivery estimates.
                        </p>
                    </div>
                </div>
            </div>

            <!-- FAQ 4 -->
            <div class="rounded-custom bg-card border border-border p-6 shadow-2xs hover:shadow-md hover:border-primary/40 transition-all">
                <div class="flex items-start gap-4">
                    <div class="w-8 h-8 rounded-full bg-primary/10 text-primary flex items-center justify-center shrink-0 font-black text-xs">
                        Q4
                    </div>
                    <div>
                        <h3 class="text-base font-bold text-card-foreground">
                            Do you ship internationally?
                        </h3>
                        <p class="text-xs sm:text-sm text-muted-foreground mt-2 leading-relaxed">
                            Yes! We ship globally to over 45 countries with carbon-neutral transit partners. All import taxes, duties, and handling fees are calculated transparently at checkout.
                        </p>
                    </div>
                </div>
            </div>

        </div>

    </div>
</section>

<!-- Bottom CTA Band: "Still have questions?" -->
<section class="py-16 sm:py-20 bg-background border-t border-border">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="rounded-custom bg-gradient-to-r from-card via-muted/60 to-card border border-border p-8 sm:p-12 text-center shadow-sm">
            <div class="w-14 h-14 mx-auto rounded-full bg-primary/10 text-primary flex items-center justify-center mb-4">
                <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </div>
            
            <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-foreground">
                Still have questions?
            </h2>
            <p class="mt-2 text-sm sm:text-base text-muted-foreground max-w-lg mx-auto">
                Can't find what you're looking for? Our concierge specialists are ready to help you directly right now.
            </p>

            <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
                <!-- Call Us Button -->
                <a href="tel:+18005552566" class="px-6 py-3.5 text-sm sm:text-base font-semibold text-foreground bg-card hover:bg-muted rounded-custom-sm border border-border shadow-2xs hover:shadow-sm active:scale-95 transition-all flex items-center gap-2">
                    <svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                    <span>Call (800) 555-PULSE</span>
                </a>

                <!-- Live Chat Button -->
                <button type="button" 
                        onclick="startLiveChat()"
                        class="px-6 py-3.5 text-sm sm:text-base font-semibold text-white bg-primary hover:opacity-90 active:scale-95 rounded-custom-sm shadow-md shadow-primary/20 transition-all flex items-center gap-2 cursor-pointer">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                    <span>Start Live Chat</span>
                </button>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Minimal vanilla JS to handle form sending/sent state
        const contactForm = document.getElementById('contact-form');
        const btnSubmit = document.getElementById('btn-submit-contact');
        const submitText = document.getElementById('submit-text');
        const submitIcon = document.getElementById('submit-icon');
        const alertBox = document.getElementById('js-contact-alert');
        const alertText = document.getElementById('js-alert-text');

        if (contactForm && btnSubmit) {
            contactForm.addEventListener('submit', async (e) => {
                e.preventDefault();

                // Validate inputs
                if (!contactForm.checkValidity()) {
                    contactForm.reportValidity();
                    return;
                }

                const formData = new FormData(contactForm);
                const originalText = submitText.textContent;

                // 1. Sending State
                btnSubmit.disabled = true;
                submitText.textContent = 'Sending message...';
                submitIcon.innerHTML = `<circle cx="12" cy="12" r="10" stroke-dasharray="32" stroke-dashoffset="12" class="animate-spin"/>`;

                try {
                    const response = await fetch(contactForm.action || window.location.href, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    if (response.ok) {
                        const data = await response.json();
                        
                        // 2. Sent State
                        submitText.textContent = 'Message Sent!';
                        submitIcon.innerHTML = `<path d="M20 6 9 17l-5-5"/>`;
                        btnSubmit.classList.remove('bg-primary');
                        btnSubmit.classList.add('bg-emerald-600');

                        // Show success banner
                        if (alertBox && alertText) {
                            alertText.textContent = data.message || "Thank you! Your message has been sent successfully.";
                            alertBox.classList.remove('hidden');
                        }

                        // Reset form
                        contactForm.reset();

                        // 3. Reset Button after 3.5s
                        setTimeout(() => {
                            submitText.textContent = originalText;
                            submitIcon.innerHTML = `<line x1="22" x2="11" y1="2" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>`;
                            btnSubmit.classList.remove('bg-emerald-600');
                            btnSubmit.classList.add('bg-primary');
                            btnSubmit.disabled = false;
                        }, 3500);
                    } else {
                        contactForm.submit(); // fallback to standard submit
                    }
                } catch {
                    contactForm.submit();
                }
            });
        }

        // Live Chat simulation
        function startLiveChat() {
            alert("Live Chat: A floral concierge specialist is connecting with you now! (Demo mode)");
        }
    </script>
}
